{
  "name": "site-starter",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "predev": "node --experimental-strip-types --no-warnings scripts/apply-client.ts --auto",
    "build": "astro check && astro build",
    "prebuild": "node --experimental-strip-types --no-warnings scripts/client-schema.ts && node --experimental-strip-types --no-warnings scripts/apply-client.ts --auto && node --experimental-strip-types --no-warnings scripts/check-placeholders.ts",
    "check": "astro check",
    "apply-client": "node --experimental-strip-types --no-warnings scripts/apply-client.ts",
    "new-site": "node --experimental-strip-types --no-warnings scripts/new-site.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/vercel": "^11.0.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "lucide-static": "^1.55.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  },
  "engines": {
    "node": ">=22.6"
  }
}
