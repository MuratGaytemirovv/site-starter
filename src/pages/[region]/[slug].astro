---
// Region pages: /<regio>/<slug>, only for regions with their own body text
// (src/content/regions/<lang>/). Regions without text are listed in the
// footer by name only — copy-paste city pages hurt SEO.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import { defaultLang, facts } from '../../lib/site';
import { getRegions, type Region } from '../../lib/collections';
import { ui } from '../../i18n/ui';

export async function getStaticPaths() {
  const t = ui(defaultLang);
  const regions = await getRegions(defaultLang);
  return regions
    .filter((r) => r.hasPage)
    .map((region) => ({ params: { region: t.routes.region, slug: region.slug }, props: { region } }));
}

interface Props {
  region: Region;
}
const { region } = Astro.props;
const t = ui(defaultLang);
const title = t.regions.title(region.name);
---

<BaseLayout title={`${title} — ${facts.name}`} description={region.body[0].slice(0, 155)}>
  <section class="py-section lg:py-section-lg">
    <Container class="max-w-3xl">
      <h1 class="text-[34px] leading-[1.1] lg:text-[48px]">{title}</h1>
      <div class="mt-6 flex flex-col gap-5 text-[17px] leading-relaxed lg:text-[18px]">
        {region.body.map((p) => <p>{p}</p>)}
      </div>
      <Button href={`/#${t.sections.contact.anchor}`} size="lg" iconEnd="arrow-right" class="mt-8">{t.cta.quote}</Button>
    </Container>
  </section>
</BaseLayout>
