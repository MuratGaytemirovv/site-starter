---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import { defaultLang, facts } from '../lib/site';
import { ui } from '../i18n/ui';

const t = ui(defaultLang);
---

<BaseLayout title={`${t.notFound.title} — ${facts.name}`} description={t.notFound.text} noindex>
  <section class="py-section lg:py-section-lg">
    <Container class="flex max-w-2xl flex-col items-start gap-6">
      <p class="font-heading text-[64px] font-extrabold leading-none text-primary-text">404</p>
      <h1 class="text-[32px] leading-tight lg:text-[44px]">{t.notFound.title}</h1>
      <p class="text-[18px] leading-relaxed text-muted">{t.notFound.text}</p>
      <Button href="/" size="lg">{t.cta.back}</Button>
    </Container>
  </section>
</BaseLayout>
