---
// Homepage = the sections from src/data/sections.json, in that order. Nothing
// client-specific here: order, on/off and variants are data.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Trust from '../components/sections/Trust.astro';
import Services from '../components/sections/Services.astro';
import About from '../components/sections/About.astro';
import Process from '../components/sections/Process.astro';
import Gallery from '../components/sections/Gallery.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import Reviews from '../components/sections/Reviews.astro';
import Faq from '../components/sections/Faq.astro';
import Contact from '../components/sections/Contact.astro';
import DemoVideo from '../components/sections/DemoVideo.astro';
import { facts, getContent, sectionVariant } from '../lib/site';
import { getGallery, getReviews, getServices } from '../lib/collections';
import { tonesFor, visibleSections } from '../lib/sections';
import { faqPage } from '../lib/jsonld';
import { themeFor } from '../lib/theme';
import { HERO_VARIANTS, type Lang, type SectionId } from '../lib/schema';
import type { PageRoute } from '../lib/routes';
import { ui } from '../i18n/ui';

interface Props {
  route: PageRoute;
  alternates: { lang: Lang; path: string }[];
}
const { route, alternates } = Astro.props;
const lang = route.lang;
const t = ui(lang);
const content = getContent(lang);
const sections = await visibleSections(lang);
// Optional demo video block: sits after services (after the hero when services are hidden).
// It is not a menu section, so it joins the list only for the background rhythm.
const video = content.video ?? null;
const videoAfter = sections.includes('services') ? 'services' : 'hero';
const blocks: (SectionId | 'demo-video')[] = video
  ? sections.flatMap((id): (SectionId | 'demo-video')[] => (id === videoAfter ? [id, 'demo-video'] : [id]))
  : sections;
const tones = tonesFor(blocks);
const [services, gallery, reviews] = await Promise.all([getServices(lang), getGallery(lang), getReviews()]);

const heroVariantRaw = sectionVariant('hero') ?? themeFor(facts).heroVariant;
if (!(HERO_VARIANTS as readonly string[]).includes(heroVariantRaw)) {
  throw new Error(`sections.json: hero.variant "${heroVariantRaw}" — expected one of ${HERO_VARIANTS.join(', ')}`);
}
const heroVariant = heroVariantRaw as (typeof HERO_VARIANTS)[number];
const jsonLd = sections.includes('faq') ? [faqPage(content.faq.items)] : [];
---

<BaseLayout lang={lang} title={content.meta.title} description={content.meta.description} path={route.path} alternates={alternates} jsonLd={jsonLd}>
  {
    blocks.map((id) => {
      switch (id) {
        case 'demo-video':
          return video && <DemoVideo content={video} tone={tones['demo-video']} />;
        case 'hero':
          return <Hero t={t} content={content.hero} variant={heroVariant} sections={sections} />;
        case 'trust':
          return <Trust t={t} content={content.trust} tone={tones.trust} />;
        case 'services':
          return <Services t={t} lang={lang} content={content.services} services={services} tone={tones.services} />;
        case 'about':
          return <About t={t} content={content.about} tone={tones.about} />;
        case 'process':
          return <Process t={t} content={content.process} tone={tones.process} />;
        case 'gallery':
          return <Gallery t={t} content={content.gallery} items={gallery} tone={tones.gallery} />;
        case 'why-us':
          return <WhyUs t={t} content={content.whyUs} tone={tones['why-us']} />;
        case 'reviews':
          return <Reviews t={t} content={content.reviews} reviews={reviews} tone={tones.reviews} />;
        case 'faq':
          return <Faq t={t} content={content.faq} tone={tones.faq} />;
        case 'contact':
          return <Contact t={t} lang={lang} content={content.contact} services={services} />;
      }
    })
  }
</BaseLayout>
