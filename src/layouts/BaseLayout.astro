---
import { getImage } from 'astro:assets';
import SEO from '../components/SEO.astro';
import DemoBanner from '../components/DemoBanner.astro';
import Topbar from '../components/layout/Topbar.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileBar from '../components/layout/MobileBar.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { facts, getContent, isPlaceholder, sectionsConfig } from '../lib/site';
import { visibleSections } from '../lib/sections';
import { getRegions } from '../lib/collections';
import { resolveImage } from '../lib/images';
import { localBusiness } from '../lib/jsonld';
import { themeFor } from '../lib/theme';
import type { Lang } from '../lib/schema';
import { ui } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  // Canonical path of this page and the same page in other languages.
  path: string;
  alternates?: { lang: Lang; path: string }[];
  // Share image: path in src/assets/images/; defaults to facts.ogImage, then the hero photo.
  image?: string | null;
  noindex?: boolean;
  // Page-specific structured data (FAQPage, BreadcrumbList, Service …).
  jsonLd?: unknown[];
}

const { lang, title, description, path, alternates = [], image, noindex, jsonLd = [] } = Astro.props;
const t = ui(lang);
const content = getContent(lang);
const theme = themeFor(facts);
const sections = await visibleSections(lang);
const site = Astro.site!;

// 1200×630 JPEG for social previews, generated from a client photo.
const ogSource = resolveImage(image ?? facts.ogImage ?? content.hero.image);
const og = ogSource ? await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 }) : null;
const ogUrl = og ? new URL(og.src, site).href : undefined;

const areaServed = (await getRegions(lang)).map((r) => r.name).filter((n) => !isPlaceholder(n));
const structured = [
  localBusiness(site, lang, { description: isPlaceholder(content.meta.description) ? undefined : content.meta.description, areaServed, image: ogUrl }),
  ...jsonLd,
].filter(Boolean);

// The only third-party embed today is the map in the footer; no map → nothing to consent to.
const needsConsent = facts.showAddress;
---

<!doctype html>
<html lang={t.htmlLang} data-style={facts.style}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={theme.themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO title={title} description={description} path={path} alternates={alternates} image={ogUrl} noindex={noindex} t={t} />
    <style is:inline set:html={theme.css} />
    {structured.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />)}
    {/* Synchronous, before first paint: without this class [data-reveal] stays visible, so no JS = no hidden content. */}
    <script is:inline>document.documentElement.classList.add('js-anim');</script>
  </head>
  <body class="pb-16 nav:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-button focus:bg-primary focus:px-4 focus:py-3 focus:text-on-primary">
      {t.skipToContent}
    </a>
    <DemoBanner t={t} />
    {sectionsConfig.topbar && <Topbar t={t} />}
    <Header t={t} lang={lang} sections={sections} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer t={t} lang={lang} sections={sections} />
    <MobileBar t={t} lang={lang} sections={sections} />
    {needsConsent && <CookieBanner t={t} />}
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
