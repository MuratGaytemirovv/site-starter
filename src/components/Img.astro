---
// A client photo (resized, WebP, responsive srcset) or, while there is none,
// a neutral placeholder of the same ratio so the layout does not shift when
// the real photo arrives.
// widths: size the srcset to the real cell width ×2–2.5 (a 3-column card is
// ~900px wide at most — bigger images cost Lighthouse points, Bilto lesson).
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { resolveImage } from '../lib/images';

interface Props {
  src: string | null | undefined;
  alt: string;
  ratio?: '4/3' | '3/2' | '16/9' | '1/1' | '3/4' | '4/5';
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  icon?: string;
  // Fill the parent box (parent sets the size) instead of keeping a ratio.
  fill?: boolean;
  class?: string;
}

const {
  src,
  alt,
  ratio = '4/3',
  widths = [480, 720, 960],
  sizes = '(min-width: 1024px) 33vw, 100vw',
  eager = false,
  icon = 'image',
  fill = false,
  class: className = '',
} = Astro.props;

const image = resolveImage(src);
const style = fill ? undefined : `aspect-ratio: ${ratio}`;
// Never upscale: drop widths larger than the original (keep at least one).
const srcWidths = image ? widths.filter((w) => w <= image.width) : [];
if (image && !srcWidths.length) srcWidths.push(image.width);
---

{
  image ? (
    <Image
      src={image}
      alt={alt}
      widths={srcWidths}
      sizes={sizes}
      format="webp"
      quality={78}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      class:list={['h-full w-full object-cover', className]}
      style={style}
    />
  ) : (
    <div
      class:list={['placeholder-pattern flex h-full w-full items-center justify-center text-primary-text', className]}
      style={style}
      role={alt ? 'img' : undefined}
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : 'true'}
    >
      <Icon name={icon} class="h-10 w-10 opacity-40" />
    </div>
  )
}
