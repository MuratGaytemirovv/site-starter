---
// Contact: details on the left, quote form on the right. The form works
// without JS (plain POST to /api/contact); with JS it submits in place.
// Never show "thank you" unless the server confirms delivery — otherwise the
// visitor gets the phone and e-mail instead (a lead must not vanish silently).
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';
import { addressLine, facts, links } from '../../lib/site';
import type { Content } from '../../lib/schema';
import type { Service } from '../../lib/collections';
import type { UI } from '../../i18n/ui';

interface Props {
  t: UI;
  content: Content['contact'];
  services: Service[];
}
const { t, content, services } = Astro.props;
const f = t.form;
const field =
  'w-full rounded-card border border-ink-line bg-ink-soft px-4 py-3.5 text-[16px] text-on-ink placeholder:text-on-ink-muted transition-[border-color,box-shadow] hover:border-on-ink-muted focus:border-primary-on-ink focus:shadow-[0_0_0_3px_color-mix(in_srgb,var(--color-primary)_35%,transparent)] focus:outline-none';
const label = 'text-[13px] font-semibold text-on-ink-muted';
const row = 'flex items-center gap-3 text-[16px] text-on-ink transition-colors hover:text-primary-on-ink';
---

<Section id={t.sections.contact.anchor} tone="dark" containerClass="grid grid-cols-1 gap-12 nav:grid-cols-2 lg:gap-20">
  <div class="flex flex-col">
    <SectionHeading eyebrow={content.eyebrow} title={content.title} intro={content.text} tone="dark" class="pb-8!" />
    {
      facts.responseTime && (
        <p class="flex items-center gap-2.5 text-[16px] font-semibold text-on-ink" data-reveal>
          <Icon name="clock" class="h-5 w-5 text-primary-on-ink" />
          {facts.responseTime}
        </p>
      )
    }
    <ul class="mt-8 flex flex-col gap-4 border-t border-ink-line pt-8" data-reveal>
      <li><a href={links.tel} class={row}><Icon name="phone" class="h-5 w-5 shrink-0 text-primary-on-ink" />{facts.phone}</a></li>
      {
        links.whatsapp && (
          <li><a href={links.whatsapp} target="_blank" rel="noopener" class={row}><Icon name="whatsapp" class="h-5 w-5 shrink-0 text-primary-on-ink" />{t.cta.whatsapp}</a></li>
        )
      }
      <li><a href={links.mail} class={row}><Icon name="mail" class="h-5 w-5 shrink-0 text-primary-on-ink" /><span class="break-all">{facts.email}</span></a></li>
      {
        facts.showAddress && (
          <li>
            <a href={links.maps} target="_blank" rel="noopener noreferrer" class={row}>
              <Icon name="map-pin" class="h-5 w-5 shrink-0 text-primary-on-ink" />
              {addressLine}
              <span class="sr-only">{t.contact.opensMaps}</span>
            </a>
          </li>
        )
      }
    </ul>
  </div>

  <form
    method="post"
    action="/api/contact"
    data-contact-form
    class="flex flex-col gap-4 rounded-card border border-ink-line bg-ink-soft/60 p-6 sm:p-8"
    data-reveal
  >
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <label class="flex flex-col gap-2">
        <span class={label}>{f.name} *</span>
        <input name="name" type="text" required maxlength="120" autocomplete="name" class={field} />
      </label>
      <label class="flex flex-col gap-2">
        <span class={label}>{f.phone} *</span>
        <input name="phone" type="tel" required maxlength="40" autocomplete="tel" class={field} />
      </label>
    </div>
    <label class="flex flex-col gap-2">
      <span class={label}>{f.email}</span>
      <input name="email" type="email" maxlength="160" autocomplete="email" class={field} />
    </label>
    {
      services.length > 0 && (
        <label class="flex flex-col gap-2">
          <span class={label}>{f.service}</span>
          <select name="service" class={field}>
            <option value="">{f.servicePlaceholder}</option>
            {services.map((s) => <option value={s.key}>{s.title}</option>)}
            <option value="other">{f.serviceOther}</option>
          </select>
        </label>
      )
    }
    <label class="flex flex-col gap-2">
      <span class={label}>{f.message}</span>
      <textarea name="message" rows="4" maxlength="4000" placeholder={f.messagePlaceholder} class:list={[field, 'min-h-[120px] resize-y']}></textarea>
    </label>
    {/* Honeypot: hidden from people, bots fill it in. */}
    <div class="sr-only" aria-hidden="true">
      <label>{f.honeypot}<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
    </div>
    <button
      type="submit"
      class="mt-2 inline-flex min-h-14 items-center justify-center gap-2 rounded-button bg-primary px-7 py-4 text-[16px] font-bold text-on-primary transition-[background-color,translate] hover:-translate-y-0.5 hover:bg-primary-hover disabled:pointer-events-none disabled:opacity-60"
      data-label={f.submit}
      data-sending={f.sending}
    >
      {f.submit}
    </button>
    <p class="text-[13px] text-on-ink-muted">{f.privacyNote}</p>
    <div data-form-status hidden role="status" class="rounded-card px-4 py-3 text-[15px] font-medium"></div>
    <template data-form-success>{f.success}</template>
    <template data-form-failed>
      {f.failed}{' '}
      <a href={links.tel} class="font-bold underline">{facts.phone}</a> · <a href={links.mail} class="font-bold underline">{facts.email}</a>
    </template>
  </form>
</Section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const show = (kind: 'success' | 'failed') => {
      const template = form.querySelector<HTMLTemplateElement>(`[data-form-${kind}]`);
      if (!status || !template) return;
      status.replaceChildren(template.content.cloneNode(true));
      status.className = `rounded-card px-4 py-3 text-[15px] font-medium ${kind === 'success' ? 'bg-primary text-on-primary' : 'bg-bg text-heading'}`;
      status.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!button) return;
      button.disabled = true;
      button.textContent = button.dataset.sending ?? '';
      let delivered = false;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        delivered = response.ok && (await response.json()).ok === true;
      } catch {
        delivered = false;
      }
      button.disabled = false;
      button.textContent = button.dataset.label ?? '';
      show(delivered ? 'success' : 'failed');
      if (delivered) form.reset();
    });
  });
</script>
