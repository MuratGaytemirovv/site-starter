---
// Trust strip right under the hero. Only confirmed facts (guarantee,
// insurance, registrations, real response time) — never invented badges.
import Container from '../Container.astro';
import Icon from '../Icon.astro';
import type { Content } from '../../lib/schema';
import type { Tone } from '../../lib/sections';
import type { UI } from '../../i18n/ui';

interface Props {
  t: UI;
  content: Content['trust'];
  tone: Tone;
}
const { t, content, tone } = Astro.props;
---

<section id={t.sections.trust.anchor} class:list={['border-y border-line', tone === 'alt' ? 'bg-surface' : 'bg-bg']}>
  <Container>
    <ul class="grid grid-cols-1 gap-x-8 gap-y-4 py-7 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {
        content.items.map((item) => (
          <li class="flex items-center gap-3" data-reveal>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary-text">
              <Icon name={item.icon} class="h-5 w-5" />
            </span>
            <span class="text-[15px] font-semibold leading-snug text-heading">{item.label}</span>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
