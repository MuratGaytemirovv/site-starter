---
// Reasons to choose this business: concrete, confirmed facts per item.
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';
import type { Content } from '../../lib/schema';
import type { Tone } from '../../lib/sections';
import type { UI } from '../../i18n/ui';

interface Props {
  t: UI;
  content: Content['whyUs'];
  tone: Tone;
}
const { t, content, tone } = Astro.props;
const n = content.items.length;
const grid = n % 3 === 0 ? 'lg:grid-cols-3' : n % 4 === 0 ? 'lg:grid-cols-4' : 'lg:grid-cols-2';
const card = tone === 'alt' ? 'bg-bg' : 'bg-surface';
---

<Section id={t.sections['why-us'].anchor} tone={tone}>
  <SectionHeading eyebrow={content.eyebrow} title={content.title} />
  <ul class:list={['grid grid-cols-1 gap-5 sm:grid-cols-2 lg:gap-7', grid]} data-reveal-group>
    {
      content.items.map((item) => (
        <li class:list={['flex flex-col gap-3 rounded-card p-6 lg:p-8', card]} data-reveal>
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-soft text-primary-text">
            <Icon name={item.icon} class="h-[22px] w-[22px]" />
          </span>
          <h3 class="mt-1 text-[19px] leading-snug lg:text-[21px]">{item.title}</h3>
          <p class="text-[15px] leading-relaxed text-muted lg:text-[16px]">{item.text}</p>
        </li>
      ))
    }
  </ul>
</Section>
