---
// Steps of working together. The grid has exactly as many columns as steps
// (up to 5) so it never leaves holes.
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import type { Content } from '../../lib/schema';
import type { Tone } from '../../lib/sections';
import type { UI } from '../../i18n/ui';

interface Props {
  t: UI;
  content: Content['process'];
  tone: Tone;
}
const { t, content, tone } = Astro.props;
const n = content.steps.length;
// Literal class names so Tailwind can see them.
const cols: Record<number, string> = {
  2: 'sm:grid-cols-2',
  3: 'nav:grid-cols-3',
  4: 'sm:grid-cols-2 nav:grid-cols-4',
  5: 'nav:grid-cols-5',
};
const grid = cols[n] ?? (n % 3 === 0 ? 'sm:grid-cols-2 nav:grid-cols-3' : 'sm:grid-cols-2');
---

<Section id={t.sections.process.anchor} tone={tone}>
  <SectionHeading eyebrow={content.eyebrow} title={content.title} />
  <ol class:list={['grid grid-cols-1 gap-x-8 gap-y-10', grid]} data-reveal-group>
    {
      content.steps.map((step, i) => (
        <li class="relative flex flex-col gap-3 border-t-2 border-line pt-6" data-reveal>
          <span class="absolute -top-[2px] left-0 h-[2px] w-12 bg-primary" aria-hidden="true" />
          <span class="font-heading text-[15px] font-bold tabular-nums text-primary-text">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="text-[20px] leading-snug">{step.title}</h3>
          <p class="text-[16px] leading-relaxed text-muted">{step.text}</p>
        </li>
      ))
    }
  </ol>
</Section>
