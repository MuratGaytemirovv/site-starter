---
// Demo video (home.<lang>.video in client.json) for the /video page: the clip of the
// site on computer and phone, linked from a follow-up mail. Poster, src and controls
// are in the HTML, so it shows and plays on every phone; muted autoplay as a bonus
// (off with reduced motion). width/height reserve the space (no layout shift).
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import Button from '../Button.astro';
import type { Content } from '../../lib/schema';

type Video = NonNullable<Content['video']>;
interface Props {
  content: Video;
  cta: string;
  href: string;
}
const { content, cta, href } = Astro.props;
---

<Section id="demo-video" tone="base">
  <SectionHeading eyebrow={content.eyebrow} title={content.title} intro={content.caption} align="split" />
  <div class="mx-auto flex w-full max-w-[960px] flex-col items-start gap-8">
    <video
      data-demo-video
      src={content.src}
      poster={content.poster}
      class="block h-auto w-full rounded-card border border-line bg-ink-soft shadow-[0_18px_36px_-18px_rgb(0_0_0/0.25)]"
      style={`aspect-ratio: ${content.width} / ${content.height};`}
      width={content.width}
      height={content.height}
      controls
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={content.alt}></video>
    <Button href={href} size="lg" iconEnd="arrow-right">{cta}</Button>
  </div>
</Section>

<script>
  const video = document.querySelector<HTMLVideoElement>('video[data-demo-video]');
  if (video && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) video.play().catch(() => {});
</script>
