---
// Demo video block (optional, from home.<lang>.video in client.json). src, poster
// and controls are plain HTML (work without JS, on iOS Safari too); preload="none"
// keeps the file from loading until the first tap. Muted autoplay is a bonus.
// width/height reserve the space (no layout shift).
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import type { Content } from '../../lib/schema';
import type { Tone } from '../../lib/sections';

type Video = NonNullable<Content['video']>;
interface Props {
  content: Video;
  tone: Tone;
}
const { content, tone } = Astro.props;
---

<Section id="demo-video" tone={tone}>
  <SectionHeading eyebrow={content.eyebrow} title={content.title} intro={content.caption} align="split" />
  {/* No data-reveal here: the video must never depend on the observer to be visible. */}
  <div class="mx-auto w-full max-w-[960px]">
    <video
      data-demo-video
      src={content.src}
      poster={content.poster}
      class="block h-auto w-full rounded-card border border-line bg-ink-soft shadow-[0_18px_36px_-18px_rgb(0_0_0/0.25)]"
      style={`aspect-ratio: ${content.width} / ${content.height};`}
      width={content.width}
      height={content.height}
      controls
      muted
      loop
      playsinline
      preload="none"
      aria-label={content.alt}></video>
  </div>
</Section>

<script>
  // Autoplay is only a bonus (iOS Low Power Mode / data saver block it): poster and
  // controls are in the HTML, so a tap always works. Autoplays once, muted, the first
  // time the block is mostly visible; pauses when it leaves the screen.
  const video = document.querySelector<HTMLVideoElement>('video[data-demo-video]');
  if (video) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let tried = false;
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.intersectionRatio > 0.35) {
          if (still || tried) return;
          tried = true;
          video.play().catch(() => {});
        } else if (!video.paused) {
          video.pause();
        }
      },
      { threshold: [0, 0.35] },
    );
    io.observe(video);
  }
</script>
