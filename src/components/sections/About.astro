---
// About: who is behind the business + confirmed numbers (content → about.stats).
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import Img from '../Img.astro';
import type { Content } from '../../lib/schema';
import type { Tone } from '../../lib/sections';
import type { UI } from '../../i18n/ui';

interface Props {
  t: UI;
  content: Content['about'];
  tone: Tone;
}
const { t, content, tone } = Astro.props;
---

<Section id={t.sections.about.anchor} tone={tone} containerClass="grid grid-cols-1 items-center gap-12 nav:grid-cols-2 lg:gap-20">
  <div class="relative mx-auto w-full max-w-[520px]" data-reveal>
    <div class="absolute -bottom-4 -right-4 h-full w-full rounded-card border-2 border-primary" aria-hidden="true"></div>
    <div class="relative overflow-hidden rounded-card">
      <Img src={content.image} alt={content.imageAlt} ratio="4/5" icon="users" widths={[480, 720, 1040]} sizes="(min-width: 960px) 520px, 100vw" />
    </div>
  </div>
  <div>
    <SectionHeading eyebrow={content.eyebrow} title={content.title} class="pb-6! lg:pb-8!" />
    <div class="flex flex-col gap-4" data-reveal>
      {content.paragraphs.map((p) => <p class="text-[17px] leading-relaxed lg:text-[18px]">{p}</p>)}
    </div>
    {
      content.stats.length > 0 && (
        <dl class="mt-8 grid grid-cols-2 gap-6 border-t border-line pt-6 sm:grid-cols-3" data-reveal>
          {content.stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-heading text-[32px] font-extrabold leading-none text-heading lg:text-[38px]">{s.value}</dd>
              <dd class="mt-2 text-[14px] leading-snug text-muted">{s.label}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</Section>
