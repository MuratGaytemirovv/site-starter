---
// Bottom bar on phones: Call · WhatsApp · Quote — the main source of leads
// from mobile. The quote link goes to the home page form, so it works on every page.
import Icon from '../Icon.astro';
import { links } from '../../lib/site';
import { sectionHref } from '../../lib/routes';
import type { Lang, SectionId } from '../../lib/schema';
import type { UI } from '../../i18n/ui';

interface Props {
  t: UI;
  lang: Lang;
  sections: SectionId[];
}
const { t, lang, sections } = Astro.props;
const cell = 'flex flex-1 items-center justify-center gap-2 text-[15px] font-bold';
// Three cells don't fit with labels on a narrow phone: icons only there (label stays for screen readers).
const label = links.whatsapp ? 'max-[379px]:sr-only' : '';
---

<div class="fixed inset-x-0 bottom-0 z-40 flex h-16 border-t border-line bg-bg shadow-[0_-6px_18px_rgb(0_0_0/0.08)] nav:hidden">
  <a href={links.tel} class:list={[cell, 'border-r border-line text-heading']}>
    <Icon name="phone" class="h-5 w-5 shrink-0 text-primary-text" /><span class={label}>{t.cta.call}</span>
  </a>
  {
    links.whatsapp && (
      <a href={links.whatsapp} target="_blank" rel="noopener" class:list={[cell, 'border-r border-line text-heading']}>
        <Icon name="whatsapp" class="h-5 w-5 shrink-0 text-primary-text" /><span class={label}>{t.cta.whatsapp}</span>
      </a>
    )
  }
  {
    sections.includes('contact') && (
      <a href={sectionHref(lang, 'contact')} class:list={[cell, 'flex-[1.3] bg-primary px-2 text-center leading-tight text-on-primary', links.whatsapp && 'max-[379px]:flex-[2.4]']}>
        {t.cta.quote}
      </a>
    )
  }
</div>
