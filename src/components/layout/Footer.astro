---
import Container from '../Container.astro';
import Icon from '../Icon.astro';
import Logo from '../Logo.astro';
import { addressLine, facts, getContent, links } from '../../lib/site';
import { getRegions, getServices } from '../../lib/collections';
import { homePath, legalPath, regionPath, sectionHref, servicePath } from '../../lib/routes';
import { formatHours } from '../../lib/hours';
import type { Lang, SectionId } from '../../lib/schema';
import type { UI } from '../../i18n/ui';

interface Props {
  t: UI;
  lang: Lang;
  sections: SectionId[];
}
const { t, lang, sections } = Astro.props;

const content = getContent(lang);
const services = sections.includes('services') ? await getServices(lang) : [];
const regions = await getRegions(lang);
const companyNav = sections.filter((id) => !['hero', 'trust', 'services'].includes(id) && t.sections[id].nav);
const social = Object.entries(facts.social).filter((entry): entry is [string, string] => !!entry[1]);
const year = new Date().getFullYear();
const hours = formatHours(facts.openingHours, t);

const heading = 'font-heading text-[13px] font-semibold uppercase tracking-[0.12em] text-primary-on-ink';
const link = 'text-[15px] text-on-ink-muted transition-colors hover:text-on-ink';
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(`${addressLine}, ${facts.address.country}`)}&output=embed`;
---

<footer class="border-t border-ink-line bg-ink text-on-ink">
  <Container class="py-section lg:py-20">
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr_1.3fr]">
      <div>
        <a href={homePath(lang)} aria-label={`${facts.name} — ${t.nav.home}`}><Logo tone="dark" /></a>
        {content.footer.tagline && <p class="mt-4 max-w-[280px] text-[15px] leading-relaxed text-on-ink-muted">{content.footer.tagline}</p>}
        {
          social.length > 0 && (
            <ul class="mt-5 flex gap-3">
              {social.map(([name, url]) => (
                <li>
                  <a href={url} target="_blank" rel="noopener" class="flex h-10 w-10 items-center justify-center rounded-full border border-ink-line text-on-ink-muted transition-colors hover:border-primary-on-ink hover:text-on-ink">
                    <Icon name={name} class="h-[18px] w-[18px]" />
                    <span class="sr-only">{name}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        services.length > 0 && (
          <div>
            <p class={heading}>{t.footer.services}</p>
            <ul class="mt-4 flex flex-col gap-3">
              {services.map((s) => (
                <li><a href={servicePath(lang, s.slug)} class={link}>{s.title}</a></li>
              ))}
            </ul>
          </div>
        )
      }

      {
        companyNav.length > 0 && (
          <div>
            <p class={heading}>{t.footer.company}</p>
            <ul class="mt-4 flex flex-col gap-3">
              {companyNav.map((id) => (
                <li><a href={sectionHref(lang, id)} class={link}>{t.sections[id].nav}</a></li>
              ))}
            </ul>
          </div>
        )
      }

      <div>
        <p class={heading}>{t.footer.contact}</p>
        <ul class="mt-4 flex flex-col gap-3">
          <li><a href={links.tel} class:list={[link, 'flex items-center gap-2.5']}><Icon name="phone" class="h-4 w-4 shrink-0 text-primary-on-ink" />{facts.phone}</a></li>
          {links.mail && <li><a href={links.mail} class:list={[link, 'flex min-w-0 items-center gap-2.5']}><Icon name="mail" class="h-4 w-4 shrink-0 text-primary-on-ink" /><span class="break-all">{facts.email}</span></a></li>}
          {
            facts.showAddress && (
              <li>
                <a href={links.maps} target="_blank" rel="noopener noreferrer" class:list={[link, 'flex items-start gap-2.5']}>
                  <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-primary-on-ink" />
                  {addressLine}
                  <span class="sr-only">{t.contact.opensMaps}</span>
                </a>
              </li>
            )
          }
        </ul>
        {
          hours.length > 0 && (
            <dl class="mt-5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[14px] text-on-ink-muted" aria-label={t.contact.hours}>
              {hours.map((h) => (
                <>
                  <dt>{h.days}</dt>
                  <dd>{h.time}</dd>
                </>
              ))}
            </dl>
          )
        }
        {
          /* The iframe is created by scripts/consent.ts only after consent for
             external media — Google sets cookies as soon as the embed loads. */
          facts.showAddress && (
            <div
              data-consent-media
              data-src={mapSrc}
              data-title={addressLine}
              class="relative mt-5 aspect-video overflow-hidden rounded-card border border-ink-line bg-ink-soft"
            >
              <div data-consent-placeholder class="flex h-full flex-col items-center justify-center gap-2.5 p-3 text-center">
                <p class="text-[13px] leading-snug text-on-ink-muted">{t.cookies.mapPlaceholder}</p>
                <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
                  <button type="button" data-consent-load class="min-h-10 rounded-button bg-primary px-4 py-2 text-[13px] font-semibold text-on-primary hover:bg-primary-hover">
                    {t.cookies.loadMap}
                  </button>
                  <a href={links.maps} target="_blank" rel="noopener noreferrer" class="text-[13px] text-on-ink-muted underline underline-offset-4 hover:text-on-ink">
                    {t.cookies.openMaps}
                  </a>
                </div>
              </div>
            </div>
          )
        }
      </div>
    </div>

    {
      regions.length > 0 && (
        <div class="mt-14 flex flex-col gap-3 border-t border-ink-line pt-8 sm:flex-row sm:items-center sm:gap-8">
          <p class="text-[13px] font-semibold uppercase tracking-[0.12em] text-on-ink-muted">{t.regions.activeIn}</p>
          <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[14px] text-on-ink-muted">
            {regions.map((r) => (
              <li>{r.hasPage ? <a href={regionPath(lang, r.slug)} class="hover:text-on-ink">{r.name}</a> : r.name}</li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="mt-8 flex flex-col gap-3 border-t border-ink-line pt-6 text-[14px] text-on-ink-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {facts.legalName ?? facts.name}{facts.vat && ` · ${t.contact.vat} ${facts.vat}`}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li><a href={legalPath(lang, 'privacy')} class="underline-offset-4 hover:text-on-ink hover:underline">{t.legal.privacy}</a></li>
        <li><a href={legalPath(lang, 'cookies')} class="underline-offset-4 hover:text-on-ink hover:underline">{t.legal.cookies}</a></li>
        {
          facts.showAddress && (
            <li>
              <button type="button" data-cookie-reopen class="underline-offset-4 hover:text-on-ink hover:underline">
                {t.footer.cookieSettings}
              </button>
            </li>
          )
        }
      </ul>
    </div>
  </Container>
</footer>
