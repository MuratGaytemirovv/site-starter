# Contact form delivery — set these in Vercel (Project → Settings → Environment
# Variables), never commit real values. At least one channel must be set, or
# the form honestly answers "not delivered" and shows phone/e-mail instead.

# E-mail via Resend (resend.com, region EU). The sending domain must be verified
# in Resend on a sub-domain (records "send" + "resend._domainkey"; don't touch the
# domain's own MX/SPF). Without a verified domain Resend only delivers to the
# account owner.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Website <noreply@send.example.be>"
# Recipient; defaults to `email` in site-facts.json.
CONTACT_TO_EMAIL=

# Telegram notification: a bot from @BotFather, the chat (or group) id, and
# optionally a forum topic id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# Optional: Odoo CRM lead via Odoo's own website form (see integraties/odoo-crm.md).
ODOO_LEAD_FORM_URL=
ODOO_LEAD_TEAM_ID=
ODOO_LEAD_USER_ID=
